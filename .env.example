# Copy to .env.local and fill in. Never commit .env.local.
# Firebase web app config (Console > Project settings > Your apps). It ships to the browser,
# so access is protected by Security Rules and App Check, not by hiding these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# App Check: reCAPTCHA Enterprise site key (production)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local development only: "true" prints a debug token in the console to register,
# or paste an already registered token. Ignored in production builds.
VITE_APPCHECK_DEBUG=

# "true" = use local Firebase emulators with the demo project (no real project needed)
VITE_USE_EMULATORS=false
